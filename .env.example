# Copy to .env.local for local dev. Set the same keys in Vercel for production.

# Public base URL (used for metadata / OG). Vercel sets VERCEL_URL automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gemini (server only). Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model id; default is the stable flash alias.
GEMINI_MODEL=gemini-flash-latest
# Optional: MINIMAL | LOW | MEDIUM | HIGH for models that support thinking levels. Leave empty for model default.
GEMINI_THINKING_LEVEL=
# Per-million-token prices used for the daily spend cap estimate (USD).
LLM_PRICE_IN_PER_M=0.5
LLM_PRICE_OUT_PER_M=3

# Public demo guards
# Max model spend per UTC day across all demo users, in US dollars.
DAILY_SPEND_CAP_USD=5
# Requests per IP per 10 minutes for the LLM endpoints.
RATE_LIMIT_PER_10MIN=20

# Upstash Redis (rate limit + spend counters). Added automatically by the Vercel Marketplace integration.
# If unset, an in-memory store is used (fine locally, not across serverless instances).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Live mode (Auth.js + Google)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Travel (Duffel test mode only; token starts with duffel_test_)
DUFFEL_TEST_TOKEN=
